---
import "../styles/fonts.css";
import "../styles/landing.css";
import Closing from "../components/Closing.astro";
import CodeSection from "../components/CodeSection.astro";
import Hero from "../components/Hero.astro";
import LiveExample from "../components/LiveExample.astro";
import UseCases from "../components/UseCases.astro";

export const accents = [
  { id: "magenta", label: "Magenta", hex: "#ff2e7e" },
  { id: "cobalt", label: "Cobalt", hex: "#2b59ff" },
  { id: "cyan", label: "Cyan", hex: "#00c8ff" },
] as const;

interface Props {
  accent: (typeof accents)[number]["id"];
}
const { accent } = Astro.props;
---

<!doctype html>
<html lang="en" data-accent={accent}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>NoCentralDB: the local-first database for people and agents</title>
    <meta
      name="description"
      content="Every member keeps its own copy, under its own keys. The relay in the middle cannot read a byte."
    />
    <meta name="theme-color" content="#121211" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <script is:inline>
      if (new URLSearchParams(location.search).has("shot")) document.documentElement.dataset.shot = "";
    </script>
  </head>
  <body>
    <nav class="nav" aria-label="Main">
      <div class="wrap">
        <a class="brand" href="/">No<span>Central</span>DB</a>
        <ul>
          <li class="hide-s"><a class="link" href="#use-cases">Use cases</a></li>
          <li class="hide-s"><a class="link" href="#code">Code</a></li>
          <li><a class="link" href="/docs/">Docs</a></li>
          <li><a class="link" href="https://github.com/nocentraldb/nocentraldb">GitHub</a></li>
        </ul>
      </div>
    </nav>
    <main>
      <Hero />
      <UseCases />
      <LiveExample />
      <CodeSection />
      <Closing />
    </main>
    <nav class="switcher" aria-label="Draft: accent colour">
      <span>Draft accent</span>
      {
        accents.map((a) => (
          <a href={`/accent/${a.id}/`} aria-current={a.id === accent ? "true" : "false"}>
            <i style={`background:${a.hex}`} />
            {a.label}
          </a>
        ))
      }
    </nav>
  </body>
</html>

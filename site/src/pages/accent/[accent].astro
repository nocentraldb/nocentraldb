---
// One page per candidate accent colour, for the owner to compare (NOC-211).
import Landing, { accents } from "../../layouts/Landing.astro";

export function getStaticPaths() {
  return accents.map((a) => ({ params: { accent: a.id }, props: { accent: a.id } }));
}
const { accent } = Astro.props;
---

<Landing accent={accent} />

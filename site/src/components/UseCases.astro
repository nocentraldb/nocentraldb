---
// The eight use cases of docs/use-cases.md, one line each, linking to the
// full text. Copy follows BRAND.md's claims rules: "designed to", and every
// line about erasure names its limit.
const base =
  "https://github.com/nocentraldb/nocentraldb/blob/main/docs/use-cases.md";
const groups = [
  {
    title: "Why the data sits with the people and agents",
    items: [
      [
        "Shred a person, not a backup hunt",
        "A person's data can be shredded by destroying their key. It does not reach devices that never come back online.",
        "1-erasure-that-reaches-every-copy",
      ],
      [
        "A relay breach leaks no content",
        "The relay is designed to hold no keys. A copy of its database is ciphertext and metadata.",
        "2-a-breach-of-the-relay-leaks-nothing-readable",
      ],
      [
        "An outside agent in one space",
        "It gets the keys of one space, signs every write, and the relay sends it no new changes once you remove it.",
        "3-an-outside-agent-limited-to-one-space",
      ],
      [
        "A thousand agent queries a minute",
        "Agents query their own copy: no round trip, no rate limit, no cost per read. Writes still go through the relay.",
        "4-a-thousand-agent-queries-a-minute-reads-at-no-cost",
      ],
      [
        "The relay goes down, work goes on",
        "In island mode every member keeps reading and writing. On rejoin, every copy converges.",
        "5-the-relay-goes-down-and-everyone-keeps-working",
      ],
    ],
  },
  {
    title: "What you keep without a server in the middle",
    items: [
      [
        "Writing together through a tunnel",
        "Collision-free edits on shared text: both keep typing offline, and no text is lost when they meet again.",
        "6-writing-together-through-a-tunnel",
      ],
      [
        "Subscribe instead of poll",
        "A query on a declared index calls your app when a change may alter its page.",
        "7-subscribe-instead-of-poll",
      ],
      [
        "Streaming as a data type",
        "An agent's answer arrives chunk by chunk, over the same encrypted change stream.",
        "8-streaming-as-a-data-type",
      ],
    ],
  },
];
---

<section id="use-cases" aria-labelledby="uc-title">
  <div class="wrap">
    <h2 id="uc-title">Your data lives where the work happens.</h2>
    <p class="section-lead">
      On every device and with every agent you trust, under your own keys. The cloud carries it. It never owns it.
    </p>
    {
      groups.map((g) => (
        <div class="group">
          <h3>{g.title}</h3>
          <ul class="cards">
            {g.items.map(([t, line, anchor]) => (
              <li>
                <a class="card" href={`${base}#${anchor}`}>
                  <strong>{t}</strong>
                  <span>{line}</span>
                  <em class="link">Read the case</em>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<style>
  .group {
    margin-top: 56px;
  }
  h3 {
    margin-bottom: 20px;
  }
  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 12px;
  }
  .card {
    display: grid;
    gap: 10px;
    align-content: start;
    height: 100%;
    padding: 22px 22px 24px;
    text-decoration: none;
  }
  .card strong {
    font-family: var(--ncdb-font-heading);
    font-weight: var(--ncdb-weight-heading);
    font-size: var(--ncdb-text-body);
    line-height: 1.25;
  }
  .card span {
    font-size: 15px;
    color: var(--ncdb-muted);
  }
  .card em {
    font-style: normal;
    font-size: var(--ncdb-text-small);
    justify-self: start;
    margin-top: 4px;
  }
  .card:hover em,
  .card:focus-visible em {
    background-size: 100% 2px;
  }
</style>

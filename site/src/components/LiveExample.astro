---
// Placeholder for the live core example. The layout is final; the content is
// simulated until the SDK and the relay run in the browser (a later ticket).
---

<section id="live" aria-labelledby="live-title">
  <div class="wrap">
    <h2 id="live-title">Two members, one space, and a relay that sees bytes.</h2>
    <p class="section-lead">
      Here the real SDK will run in three frames and the relay in your browser. Until then, this is a
      simulation of what you will see.
    </p>

    <div class="stage" data-live>
      <article class="frame frame-a">
        <header><b>A</b> Setup</header>
        <ol class="steps">
          <li data-s="0">Open the database</li>
          <li data-s="1">Create the space “team chat”</li>
          <li data-s="2">Add B and C as writers</li>
        </ol>
      </article>
      <article class="frame chat" data-chat="b">
        <header><b>B</b> Member</header>
        <div class="log" aria-live="off"></div>
        <div class="compose"><span data-typing="b"></span></div>
      </article>
      <article class="frame chat" data-chat="c">
        <header><b>C</b> Member</header>
        <div class="log" aria-live="off"></div>
        <div class="compose"><span data-typing="c"></span></div>
      </article>
      <article class="frame relay">
        <header><b>R</b> Relay log</header>
        <ol class="bytes" data-bytes></ol>
      </article>
      <button class="pause" type="button" data-live-pause>Pause</button>
    </div>
  </div>
</section>

<style>
  .stage {
    position: relative;
    margin-top: 48px;
    display: grid;
    grid-template-columns: 0.8fr 1fr 1fr 1.1fr;
    gap: 12px;
  }
  .frame {
    background: var(--ink-2);
    border-radius: var(--radius-m);
    padding: 16px;
    min-height: 340px;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  header {
    display: flex;
    gap: 10px;
    align-items: center;
    font-weight: 700;
    font-size: 14px;
    margin-bottom: 16px;
  }
  header b {
    display: inline-grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--lime);
    color: var(--ink);
    font-size: 13px;
  }
  .relay header b {
    background: var(--accent);
    color: var(--on-accent);
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
    font-size: 14px;
  }
  .steps li {
    display: flex;
    gap: 10px;
    align-items: baseline;
  }
  .steps li::before {
    content: "";
    flex: none;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--ink-3);
    transition: background-color 300ms;
  }
  .steps li.done::before {
    background: var(--lime);
  }
  .log {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 8px;
  }
  .log :global(p) {
    max-width: 85%;
    padding: 8px 12px;
    border-radius: 14px;
    font-size: 14px;
    line-height: 1.4;
    background: var(--ink-3);
    animation: pop 360ms var(--ease-out);
  }
  .log :global(p.mine) {
    align-self: flex-end;
    background: var(--lime);
    color: var(--ink);
    font-weight: 400;
  }
  .compose {
    margin-top: 12px;
    min-height: 40px;
    border-radius: 999px;
    background: var(--ink);
    padding: 9px 14px;
    font-size: 14px;
  }
  .compose span:not(:empty)::after {
    content: "";
    display: inline-block;
    width: 2px;
    height: 1em;
    margin-left: 2px;
    vertical-align: -2px;
    background: var(--lime);
  }
  .bytes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    flex: 1;
    gap: 8px;
  }
  .bytes :global(li) {
    font-family: var(--font-code);
    font-size: 12px;
    line-height: 1.45;
    word-break: break-all;
    padding: 8px 10px;
    border-radius: var(--radius-s);
    background: var(--ink-3);
    animation: pop 360ms var(--ease-out);
  }
  .bytes :global(li b) {
    color: var(--accent-on-ink);
    font-weight: 600;
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
  .pause {
    position: absolute;
    right: 12px;
    top: -56px;
    min-height: 40px;
    padding: 0 16px;
    border-radius: 999px;
    border: 0;
    background: var(--paper);
    color: var(--ink);
    font: 700 13px var(--font-body);
    cursor: pointer;
  }
  @media (max-width: 1000px) {
    .stage {
      grid-template-columns: 1fr 1fr;
    }
    .frame {
      min-height: 260px;
    }
  }
  @media (max-width: 560px) {
    .stage {
      grid-template-columns: 1fr;
    }
    .frame-a {
      min-height: 0;
    }
    .frame {
      min-height: 220px;
    }
    .pause {
      position: static;
      justify-self: start;
      order: -1;
    }
  }
</style>

<script is:inline>
  (() => {
    const root = document.querySelector("[data-live]");
    if (!root) return;
    const $ = (s) => root.querySelector(s);
    const hex = (n) =>
      Array.from(crypto.getRandomValues(new Uint8Array(n)), (b) => b.toString(16).padStart(2, "0")).join("");
    const script = [
      ["b", "Can you look at the relay draft?"],
      ["c", "On it. Reading my own copy, so no wait."],
      ["b", "I'm offline from here, train tunnel."],
      ["c", "Fine, it syncs when you're back."],
    ];
    const say = (who, text) => {
      for (const side of ["b", "c"]) {
        const p = document.createElement("p");
        p.textContent = text;
        if (side === who) p.className = "mine";
        const log = $(`[data-chat="${side}"] .log`);
        log.append(p);
        while (log.children.length > 4) log.firstElementChild.remove();
      }
      const li = document.createElement("li");
      li.innerHTML = `<b>${who.toUpperCase()} · gen 1 · ${120 + text.length * 2} B</b><br>`;
      li.append(hex(18));
      const bytes = $("[data-bytes]");
      bytes.append(li);
      while (bytes.children.length > 4) bytes.firstElementChild.remove();
    };
    const steps = [...root.querySelectorAll(".steps li")];
    const still =
      matchMedia("(prefers-reduced-motion: reduce)").matches ||
      document.documentElement.dataset.shot !== undefined;
    if (still) {
      steps.forEach((s) => s.classList.add("done"));
      script.forEach(([w, t]) => say(w, t));
      $("[data-live-pause]").hidden = true;
      return;
    }
    let t = 0;
    let paused = false;
    let typing = null;
    const tick = () => {
      if (paused) return;
      if (t < steps.length) {
        steps[t].classList.add("done");
      } else {
        const [who, text] = script[(t - steps.length) % script.length];
        const box = $(`[data-typing="${who}"]`);
        let k = 0;
        clearInterval(typing);
        typing = setInterval(() => {
          box.textContent = text.slice(0, ++k);
          if (k >= text.length) {
            clearInterval(typing);
            setTimeout(() => {
              box.textContent = "";
              say(who, text);
            }, 250);
          }
        }, 38);
      }
      t++;
    };
    let timer = setInterval(tick, 3000);
    tick();
    $("[data-live-pause]").addEventListener("click", (e) => {
      paused = !paused;
      e.currentTarget.textContent = paused ? "Play" : "Pause";
    });
  })();
</script>

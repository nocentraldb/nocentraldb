---
// The scenario: four steps stacked one under the other at every width, each with
// its title, its text and its drawing, standing still (owner, 2026-11-20, NOC-380).
// From 640px a step is a row, the words at the left and the drawing at the right; a
// phone stacks the drawing under the words. Each figure carries two drawings: the
// wide one for screens from 640px, and for a phone a small schematic without text
// (owner, 2026-11-20); scene.css shows one of them.
import { STEPS, scene } from "./scene.mjs";

const still = { still: true };
---

<section class="section" id="story" aria-labelledby="story-h">
  <div class="wrap story">
    <h2 id="story-h">Two people, one of them travelling, and an agent work on the same task list</h2>
    <ol class="story__steps">
      {
        STEPS.map((step, i) => (
          <li class="story__step">
            <h3>{step.title}</h3>
            <p>{step.text}</p>
            <figure
              class="story__visual"
              set:html={scene(i, `s${i}`, "wide", still) + scene(i, `s${i}`, "phone")}
            />
          </li>
        ))
      }
    </ol>
  </div>
</section>

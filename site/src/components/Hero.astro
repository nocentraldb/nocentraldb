---
// The first screen: eyebrow, headline, subline, two buttons, the status line
// and the fact line at the left; the scenario's first drawing at the right.
import { scene } from "./scene.mjs";
---

<section class="hero hero--split" data-enter aria-labelledby="hero-h">
  <div class="wrap">
    <div class="hero-text grid hero__grid">
      <div class="hero__text span-6">
        <p class="hero__kicker"><span class="dot" aria-hidden="true"></span>A local-first database for people and agents</p>
        <h1 id="hero-h">A database that reads like a local file and syncs like a shared doc</h1>
        <p class="hero__lead">
          Each person and each agent reads and writes a full copy on their own machine. The changes sync encrypted
          through a server that can't read them.
        </p>
        <div class="btn-row">
          <a class="btn btn--primary" href="#story">See how it works</a>
          <a class="btn btn--secondary" href="https://github.com/nocentraldb/nocentraldb/blob/main/docs/rfc/README.md"
            >Review the RFCs</a
          >
        </div>
        <p class="status-line">
          NoCentralDB does not exist yet. This page shows what it is designed to do; the design is open in the RFCs.
        </p>
        <p class="fact-line">
          SDKs for TypeScript and Rust. One core for desktop, mobile and the browser. Open source under MIT or
          Apache-2.0.
        </p>
      </div>
      <div class="span-6 start-7 hero__media">
        <div class="scene-frame" data-scene-scope>
          <Fragment set:html={scene(0, "hero")} />
          <button class="scene-pause" type="button" aria-pressed="false" aria-label="Pause the animation" data-scene-pause hidden>
            Pause
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import "./scene-pause.mjs";
</script>

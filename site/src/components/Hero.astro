---
// The first screen: what NoCentralDB is, for whom, and the one fact that
// sets it apart, shown as the same changes seen by a member and by the relay.
const rows = [
  {
    coll: "tasks",
    op: "create",
    text: "Write the README",
    meta: "open · priority 1",
    size: 312,
  },
  {
    coll: "tasks",
    op: "update",
    text: "Write the README",
    meta: "status → in_progress",
    size: 188,
  },
  {
    coll: "people",
    op: "create",
    text: "Ada ••••••",
    meta: "personal · shredable",
    size: 264,
  },
  {
    coll: "messages",
    op: "create",
    text: "Draft is up for review",
    meta: "agent · planner",
    size: 240,
  },
];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <h1 id="hero-title" class="enter" style="--d: 0ms">
        The <span class="nowrap">local-first</span> database for <mark>people and agents</mark>.
      </h1>
      <p class="lead enter" style="--d: 120ms">
        Every member keeps its own copy, under its own keys. Reads never leave the device. The relay
        in the middle stores the changes and cannot read a byte of them.
      </p>
      <div class="actions enter" style="--d: 220ms">
        <a class="btn btn-accent" href="docs/">Read the docs</a>
        <a class="btn btn-lime" href="https://github.com/nocentraldb/nocentraldb/blob/main/docs/rfc/README.md"
          >Review the RFCs</a
        >
      </div>
      <p class="status enter" style="--d: 300ms">
        In design. The API below is what the RFCs decide; nothing is released yet.
      </p>
    </div>

    <figure class="split enter" style="--d: 180ms" aria-label="The same changes, as a member and as the relay see them">
      <div class="pane pane-member">
        <p class="pane-title">On a member</p>
        <ol class="rows" data-rows="member">
          {
            rows.map((r) => (
              <li>
                <span class="tag">{r.coll}</span>
                <strong>{r.text}</strong>
                <small>{r.meta}</small>
              </li>
            ))
          }
        </ol>
      </div>
      <div class="pane pane-relay">
        <p class="pane-title">On the relay</p>
        <ol class="rows" data-rows="relay">
          {
            rows.map((r) => (
              <li>
                <span class="tag">{r.size} B</span>
                <code class="cipher" data-len="44">
                  9f3ac01e77b2d54a0c6e1f8b3d92a7e4c5b0f61d28a3
                </code>
              </li>
            ))
          }
        </ol>
      </div>
      <button class="pause" type="button" aria-pressed="false" data-pause>Pause</button>
    </figure>
  </div>
</section>

<style>
  .hero {
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: 120px 0 72px !important;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
    width: 100%;
  }
  h1 {
    font-size: clamp(34px, 4.6vw, 64px);
  }
  .nowrap {
    white-space: nowrap;
  }
  mark {
    background: none;
    color: var(--lime);
  }
  .lead {
    font-size: clamp(18px, 1.5vw, 21px);
    margin-top: 28px;
    max-width: 34ch;
  }
  .actions {
    display: flex;
    gap: 12px;
    margin-top: 36px;
    flex-wrap: wrap;
  }
  .status {
    margin-top: 28px;
    font-size: 14px;
    font-weight: 400;
    display: flex;
    gap: 10px;
    align-items: baseline;
  }
  .status::before {
    content: "";
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    transform: translateY(-1px);
  }

  .split {
    position: relative;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-radius: var(--radius-l);
    overflow: hidden;
    min-height: 420px;
  }
  .pane {
    padding: 24px 20px 64px;
    min-width: 0;
  }
  .pane-member {
    background: var(--lime);
    color: var(--ink);
  }
  .pane-relay {
    background: var(--ink-2);
    color: var(--paper);
  }
  .pane-title {
    font-family: var(--font-head);
    font-weight: 900;
    font-size: 18px;
    margin-bottom: 18px;
  }
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .rows li {
    display: grid;
    gap: 2px;
    padding: 12px 14px;
    border-radius: var(--radius-m);
    min-height: 74px;
    align-content: start;
  }
  .pane-member li {
    background: rgb(18 18 17 / 0.08);
  }
  .pane-relay li {
    background: var(--ink-3);
  }
  .rows strong {
    font-weight: 700;
    font-size: 15px;
    line-height: 1.3;
  }
  .rows small {
    font-size: 13px;
    font-weight: 400;
  }
  .tag {
    font-size: 12px;
    font-weight: 700;
  }
  .pane-relay .tag {
    color: var(--accent-on-ink);
  }
  .cipher {
    font-size: 12.5px;
    line-height: 1.45;
    word-break: break-all;
  }
  .rows li.fresh {
    animation: arrive 520ms var(--ease-out);
  }
  @keyframes arrive {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }
  .pause {
    position: absolute;
    right: 14px;
    bottom: 14px;
    min-height: 36px;
    padding: 0 14px;
    border-radius: 999px;
    border: 0;
    background: var(--paper);
    color: var(--ink);
    font: 700 13px var(--font-body);
    cursor: pointer;
  }

  .enter {
    animation: enter 700ms var(--ease-out) both;
    animation-delay: var(--d);
  }
  @keyframes enter {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero {
      min-height: auto;
    }
    .split {
      min-height: 0;
    }
  }
  @media (max-width: 520px) {
    .actions .btn {
      width: 100%;
    }
    .pane {
      padding: 18px 12px 60px;
    }
    .rows li {
      padding: 10px;
    }
    .rows strong {
      font-size: 14px;
    }
  }
</style>

<script is:inline>
  (() => {
    const member = document.querySelector('[data-rows="member"]');
    const relay = document.querySelector('[data-rows="relay"]');
    const button = document.querySelector("[data-pause]");
    if (!member || !relay || !button) return;
    const hex = (n) =>
      Array.from(crypto.getRandomValues(new Uint8Array(n)), (b) => b.toString(16).padStart(2, "0")).join("");
    relay.querySelectorAll(".cipher").forEach((c) => (c.textContent = hex(22)));
    const feed = [
      ["tasks", "Review the relay RFC", "open · priority 2", 296],
      ["tasks", "Review the relay RFC", "assignee → agent", 204],
      ["messages", "Ranked 50 open tasks", "agent · planner", 232],
      ["people", "Ada ••••••", "erased · key destroyed", 96],
      ["tasks", "Write the README", "status → done", 188],
    ];
    let i = 0;
    const step = () => {
      const [coll, text, meta, size] = feed[i++ % feed.length];
      const m = document.createElement("li");
      m.className = "fresh";
      m.innerHTML = '<span class="tag"></span><strong></strong><small></small>';
      m.children[0].textContent = coll;
      m.children[1].textContent = text;
      m.children[2].textContent = meta;
      const r = document.createElement("li");
      r.className = "fresh";
      r.innerHTML = '<span class="tag"></span><code class="cipher"></code>';
      r.children[0].textContent = `${size} B`;
      r.children[1].textContent = hex(22);
      member.prepend(m);
      relay.prepend(r);
      member.lastElementChild.remove();
      relay.lastElementChild.remove();
    };
    const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
    let timer = still || document.documentElement.dataset.shot !== undefined ? null : setInterval(step, 3200);
    if (!timer) button.hidden = true;
    button.addEventListener("click", () => {
      if (timer) {
        clearInterval(timer);
        timer = null;
        button.textContent = "Play";
        button.setAttribute("aria-pressed", "true");
      } else {
        step();
        timer = setInterval(step, 3200);
        button.textContent = "Pause";
        button.setAttribute("aria-pressed", "false");
      }
    });
  })();
</script>

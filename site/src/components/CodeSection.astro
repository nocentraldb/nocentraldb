---
// Install, then five calls on the task model, from the README's "Code examples"
// (RFC 0009). The tabs are the kit's (.tabs, .tab); the snippets keep the
// README's statements, a few dropped for length.
import { Code } from "astro:components";

const tabs = [
  {
    id: "model",
    label: "Model",
    note: "Describe the model once. ncdb model build turns it into model.lock.json.",
    code: `import { nc } from "@nocentraldb/sdk";

export const model = nc.model({
  people: nc.collection({
    name: nc.string().personal({ person: "self" }),
    email: nc.string().personal({ person: "self" }),
  }),
  tasks: nc.collection(
    {
      title: nc.string().describe("One line; what has to be done."),
      status: nc.oneOf(["open", "in_progress", "done"]),
      priority: nc.int(),
      assignee: nc.link("people"),
      dependsOn: nc.links("tasks"),
    },
    {
      indexes: {
        byStatusPriority: nc.index(["status", "priority"], { equal: 1 }),
      },
    },
  ),
});`,
  },
  {
    id: "open",
    label: "Open",
    note: "The relay is the server from the scenario above. It needs no relay to start.",
    code: `import { nc } from "@nocentraldb/sdk";
import { model } from "./model";
import lock from "./model.lock.json";

const db = await nc.open({ model, lock, relay: "wss://relay.example.com" });

const project = await db.spaces.create();`,
  },
  {
    id: "share",
    label: "Share",
    note: "The joining member sends an invitation: its public identity, never a key. An admin adds it with a role.",
    code: `// On the joining member:
const invitation = await db.invitation();
send(invitation.toString());

// On an admin of the space:
await project.members.add(nc.invitation(text), { role: "writer" });`,
  },
  {
    id: "write",
    label: "Write",
    note: "One write is one signed, encrypted change. It resolves before the relay has it.",
    code: `await project.write((tx) => {
  const task = tx.create(model.tasks, { title: "Write the README", status: "open", priority: 1 });
  tx.update(model.tasks, task, { status: "in_progress" });
});`,
  },
  {
    id: "subscribe",
    label: "Subscribe",
    note: "The listener runs at once and again after every change that may alter the page. It never waits for the network.",
    code: `const query = model.tasks.indexes.byStatusPriority.equal("open").take(50);

const stop = db.subscribe(query, (fresh) => render(fresh));`,
  },
];
---

<section class="section" id="code" aria-labelledby="code-h">
  <div class="wrap grid code-grid">
    <div class="span-5">
      <div class="section-head">
        <h2 id="code-h">Five calls in the SDK</h2>
        <p>No keys in your code: the SDK is designed to create, store and rotate them.</p>
      </div>
      <div class="install">
        <code>npm install @nocentraldb/sdk</code>
        <button type="button" class="btn btn--secondary btn--sm" data-copy="npm install @nocentraldb/sdk">Copy</button>
      </div>
      <p class="also">Rust: <code>cargo add nocentraldb</code></p>
    </div>

    <div class="span-7 start-6 code-tabs" data-tabs>
      <div class="tabs" role="tablist" aria-label="Code for the task list">
        {
          tabs.map((t, i) => (
            <button
              class="tab"
              role="tab"
              type="button"
              id={`tab-${t.id}`}
              aria-controls={`panel-${t.id}`}
              aria-selected={i === 0 ? "true" : "false"}
              tabindex={i === 0 ? 0 : -1}
            >
              {t.label}
            </button>
          ))
        }
      </div>
      {
        tabs.map((t, i) => (
          <div role="tabpanel" id={`panel-${t.id}`} aria-labelledby={`tab-${t.id}`} hidden={i !== 0}>
            <p class="note">{t.note}</p>
            <Code code={t.code} lang="ts" theme="css-variables" />
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .code-grid {
    align-content: start;
  }
  .install {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    max-width: 480px;
    padding: 6px 6px 6px var(--s-5);
    border-radius: 999px;
    background: var(--surface);
  }
  .install code {
    font-size: var(--t-small);
  }
  .install code,
  .also code {
    font-family: var(--font-mono);
    white-space: nowrap;
  }
  .also {
    margin-top: var(--s-4);
    color: var(--muted);
    font-size: var(--t-small);
  }
  .note {
    margin: var(--s-5) 0 var(--s-4);
    color: var(--muted);
    min-height: 2lh;
  }
  [role="tabpanel"] :global(pre) {
    margin: 0;
    padding: var(--s-5) var(--s-6);
    border-radius: var(--r-lg);
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.5;
    overflow-x: auto;
    /* the Model snippet's height: every panel the same, so the frame never resizes */
    min-height: calc(22lh + 2 * var(--s-5));
    /* code in ink and muted only, never the accent */
    --astro-code-background: var(--ncdb-surface);
    --astro-code-foreground: var(--ncdb-ink);
    --astro-code-token-keyword: var(--ncdb-muted);
    --astro-code-token-string: var(--ncdb-ink);
    --astro-code-token-string-expression: var(--ncdb-ink);
    --astro-code-token-function: var(--ncdb-ink);
    --astro-code-token-constant: var(--ncdb-ink);
    --astro-code-token-parameter: var(--ncdb-ink);
    --astro-code-token-comment: var(--ncdb-muted);
    --astro-code-token-punctuation: var(--ncdb-muted);
    --astro-code-token-link: var(--ncdb-ink);
  }
  @media (max-width: 1023px) {
    .code-grid > * {
      grid-column: 1 / -1;
    }
    .code-tabs {
      margin-top: var(--s-7);
    }
  }
  @media (max-width: 639px) {
    [role="tabpanel"] :global(pre) {
      padding: var(--s-4);
      font-size: 12px;
      min-height: 0;
    }
  }
</style>

<script is:inline>
  (() => {
    const root = document.querySelector("[data-tabs]");
    if (!root) return;
    const tabs = [...root.querySelectorAll("[role=tab]")];
    const select = (tab) => {
      for (const t of tabs) {
        const on = t === tab;
        t.setAttribute("aria-selected", String(on));
        t.tabIndex = on ? 0 : -1;
        document.getElementById(t.getAttribute("aria-controls")).hidden = !on;
      }
      tab.focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener("click", () => select(t));
      t.addEventListener("keydown", (e) => {
        const d = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
        if (d) select(tabs[(i + d + tabs.length) % tabs.length]);
      });
    });
    document.querySelectorAll("[data-copy]").forEach((b) =>
      b.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(b.dataset.copy);
          b.textContent = "Copied";
          setTimeout(() => (b.textContent = "Copy"), 1600);
        } catch {}
      }),
    );
  })();
</script>

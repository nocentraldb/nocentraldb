---
// The close: row 1 of footer.closing (Landing.astro), flooded yellow on the
// kit's .ground-brand, with the way into the docs, the feedback button and the use cases.
const docs = [
  ["Getting started", "Install, describe a model, open a database.", "/docs/"],
  ["Concepts", "Spaces, the relay, convergence, shredding.", "/docs/concepts/spaces/"],
  ["API", "The SDK calls, as RFC 0009 designs them.", "/docs/api/"],
  ["RFCs", "The whole design, open for your feedback.", "/docs/rfcs/"],
];
---

<div class="closing__cta ground-brand">
  <div class="section-head">
    <h2 id="close-h">Read the design, then tell us where it breaks</h2>
  </div>
  <div class="grid doc-cards">
    {
      docs.map(([t, d, href]) => (
        <a class="card span-3" href={href}>
          <h3>{t}</h3>
          <p>{d}</p>
        </a>
      ))
    }
  </div>
  <div class="btn-row close-actions">
    <a class="btn btn--primary btn--xl" href="https://github.com/nocentraldb/nocentraldb/discussions">Share your feedback</a>
    <a class="link" href="https://github.com/nocentraldb/nocentraldb/blob/main/docs/use-cases.md">See the use cases</a>
  </div>
</div>

<style>
  /* The yellow runs edge to edge, from the footer's top to the footer row:
     a spread shadow in the ground's colour, cut to the close's own band. */
  .closing__cta {
    box-shadow: 0 0 0 100vmax var(--bg);
    clip-path: inset(calc(-1 * var(--padt)) -100vmax calc(-1 * var(--s-8)) -100vmax);
    justify-content: space-between;
  }
  .closing__cta h2 {
    max-width: 18ch;
    font-size: var(--t-h1, var(--ncdb-text-heading));
  }
  /* the primary button near-black with light text (the kit's .ground-brand
     gives it the yellow as text) */
  .closing__cta .btn--primary {
    color: var(--p-ink);
  }
  /* near-black cards on the yellow ground */
  /* the cards' own gap, not the footer's link-column gap (.footer .grid) */
  .closing__cta > .doc-cards.grid {
    align-content: start;
    row-gap: var(--card-gap);
  }
  .doc-cards .card {
    --card: var(--p-bg);
    --ink: var(--p-ink);
    --muted: var(--p-muted);
    text-decoration: none;
  }
  .doc-cards h3 {
    font: var(--display-weight) var(--t-h3, 22px) / 1.25 var(--font-display);
  }
  .close-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-4) var(--s-7);
  }
  @media (min-width: 640px) and (max-width: 1023px) {
    .doc-cards > .card {
      grid-column: auto / span 6;
    }
  }
  @media (max-width: 639px) {
    .doc-cards h3 {
      font-size: 20px;
    }
  }
</style>

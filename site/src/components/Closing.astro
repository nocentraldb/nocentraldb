---
// The close: row 1 of footer.closing (Landing.astro), which is flooded yellow
// edge to edge (the kit's .ground-brand on the footer itself), with the way into
// the docs, the feedback button and the use cases.
const docs = [
  ["Getting started", "Install, describe a model, open a database.", "/docs/"],
  ["Concepts", "Spaces, the relay, convergence.", "/docs/concepts/spaces/"],
  ["API", "The SDK calls, as RFC 0009 designs them.", "/docs/api/"],
  ["RFCs", "The whole design, open for your feedback.", "/docs/rfcs/"],
];
---

<div class="closing__cta">
  <div class="section-head">
    <h2 id="close-h">Read the design, then tell us where it breaks</h2>
  </div>
  <div class="grid doc-cards">
    {
      docs.map(([t, d, href]) => (
        <a class="card span-3" href={href}>
          <h3>{t}</h3>
          <p>{d}</p>
        </a>
      ))
    }
  </div>
  <div class="btn-row close-actions">
    <a class="btn btn--primary" href="https://github.com/nocentraldb/nocentraldb/discussions">Share your feedback</a>
    <a class="link" href="https://github.com/nocentraldb/nocentraldb/blob/main/docs/use-cases.md">See the use cases</a>
  </div>
</div>

<style>
  .closing__cta {
    justify-content: space-between;
  }
  .closing__cta h2 {
    max-width: 18ch;
    font-size: var(--t-h1, var(--ncdb-text-heading));
  }
  /* the primary button near-black with light text (the kit's .ground-brand
     gives it the yellow as text) */
  .closing__cta .btn--primary {
    color: var(--p-ink);
  }
  /* near-black cards on the yellow ground, with the cards' own gap, not the
     footer's link-column gap (.footer .grid) */
  .closing__cta > .doc-cards.grid {
    align-content: start;
    row-gap: var(--card-gap);
  }
  .doc-cards .card {
    --card: var(--p-bg);
    --ink: var(--p-ink);
    --muted: var(--p-muted);
    text-decoration: none;
  }
  .doc-cards h3 {
    font: var(--display-weight) var(--t-h3, 22px) / 1.25 var(--font-display);
  }
  .close-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-4) var(--s-7);
  }
  /* two by two below a desktop, so the close stays one screen on a phone */
  @media (max-width: 1023px) {
    .doc-cards > .card {
      grid-column: auto / span 6;
    }
  }
  @media (max-width: 639px) {
    .closing__cta {
      gap: var(--s-5);
    }
    .closing__cta h2 {
      font-size: var(--t-h2);
    }
    .close-actions {
      row-gap: var(--s-2);
    }
    .close-actions .btn {
      width: 100%;
    }
    .doc-cards h3 {
      font-size: 18px;
    }
    .doc-cards .card {
      --c-pad: var(--s-4);
    }
  }
</style>

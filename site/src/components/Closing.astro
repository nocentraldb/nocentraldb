---
// Who it is not for and what it does not do (BRAND.md "Not for", GENESIS
// principle 4), the way into the docs. The footer with the endorsement line is the page shell's, in Landing.astro.
const limits = [
  [
    "The relay sees metadata.",
    "Which key is in which space, when and how much each key writes, and who reads from where. It can withhold changes.",
  ],
  [
    "Removing a member keeps their copy.",
    "The space key rotates, so they get no new changes. What they already received stays on their device.",
  ],
  [
    "Shredding has edges.",
    "It does not reach devices that never come back online, a modified client, exports, screenshots or unmarked free text.",
  ],
  [
    "v1 is not post-quantum.",
    "Ciphertext recorded today could be read by a future quantum computer.",
  ],
];
const docs = [
  ["Getting started", "Install, describe a model, open a database.", "/docs/"],
  [
    "Concepts",
    "Spaces, the relay, convergence, shredding.",
    "/docs/concepts/spaces/",
  ],
  ["API", "The SDK calls, as RFC 0009 designs them.", "/docs/api/"],
  ["RFCs", "The whole design, open for your feedback.", "/docs/rfcs/"],
];
---

<section id="limits" class="ground-yellow" aria-labelledby="limits-title">
  <div class="wrap limits-grid">
    <div>
      <h2 id="limits-title">When a central database is exactly right.</h2>
      <p class="section-lead">
        If your app needs queries on the server, analytics across all users' data, or one global truth at write time, such
        as unique names, use a central database. And know these limits before you build on NoCentralDB:
      </p>
    </div>
    <dl>
      {
        limits.map(([t, d]) => (
          <div class="card">
            <dt>{t}</dt>
            <dd>{d}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<section id="docs" aria-labelledby="docs-title">
  <div class="wrap">
    <h2 id="docs-title">Read the design, then tell us where it breaks.</h2>
    <ul class="doc-links">
      {
        docs.map(([t, d, href]) => (
          <li>
            <a class="card" href={href}>
              <strong>{t}</strong>
              <span>{d}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <a class="btn btn-primary feedback" href="https://github.com/nocentraldb/nocentraldb/discussions"
      >Share your feedback</a
    >
  </div>
</section>

<style>
  .limits-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }
  dl {
    margin: 0;
    display: grid;
    gap: 10px;
  }
  dl .card {
    padding: 20px 22px;
    color: var(--ncdb-ink);
  }
  dt {
    font-family: var(--ncdb-font-heading);
    font-weight: var(--ncdb-weight-heading);
    font-size: var(--ncdb-text-body);
  }
  dd {
    margin: 6px 0 0;
    color: var(--ncdb-muted);
  }
  .doc-links {
    list-style: none;
    margin: 48px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
  }
  .doc-links a {
    display: grid;
    gap: 8px;
    height: 100%;
    padding: 24px 22px 28px;
    text-decoration: none;
  }
  .doc-links strong {
    font-family: var(--ncdb-font-heading);
    font-weight: var(--ncdb-weight-heading);
    font-size: var(--ncdb-text-lead);
  }
  .doc-links span {
    color: var(--ncdb-muted);
  }
  .feedback {
    margin-top: 40px;
  }
  @media (max-width: 900px) {
    .limits-grid {
      grid-template-columns: 1fr;
    }
    .doc-links {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 520px) {
    .doc-links {
      grid-template-columns: 1fr;
    }
    .feedback {
      width: 100%;
    }
  }
</style>

  "scripts": {
    "gates": "moon exec :gates --force --on-failure continue",
    "gates:dev": "moon run :gates"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}

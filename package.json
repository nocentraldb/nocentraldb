{
  "name": "nocentraldb",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "packageManager": "pnpm@12.17.0",
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "error"
    }
  },
  "scripts": {
    "gates": "moon exec :gates --force --base HEAD --head HEAD --on-failure continue --summary normal",
    "gates:dev": "moon run :gates",
    "decisions": "node scripts/decisions.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@sqlite.org/sqlite-wasm": "3.54.1-build1",
    "playwright": "1.63.0",
    "smol-toml": "1.9.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}

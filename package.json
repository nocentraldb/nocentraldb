{
  "name": "nocentraldb",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "packageManager": "pnpm@12.17.0",
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "error"
    }
